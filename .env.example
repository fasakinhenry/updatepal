# public url of this frontend (used for share links)
VITE_APP_URL=http://localhost:5173
# base url of the express backend (not used until the backend stage)
VITE_API_BASE_URL=http://localhost:4000/api
# optional: google sign in, needed in the auth stage
VITE_GOOGLE_CLIENT_ID=
# optional: avatar service
VITE_DICEBEAR_BASE_URL=https://api.dicebear.com/9.x
# use mocked ai responses until the backend provides them
VITE_AI_MOCK_MODE=true
